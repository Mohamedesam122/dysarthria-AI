# Copy to .env (never commit .env). Streamlit reads real environment variables;
# export these or use your shell/IDE to load them.
DYSARTHRIA_API_URL=http://localhost:8000
DYSARTHRIA_PREDICT_PATH=/predict
DYSARTHRIA_HEALTH_PATH=/health
DYSARTHRIA_TIMEOUT_SECONDS=60
DYSARTHRIA_MAX_UPLOAD_MB=10
DYSARTHRIA_MAX_DURATION_SECONDS=30
# 1 = start in demo mode with placeholder results
DYSARTHRIA_MOCK=0
